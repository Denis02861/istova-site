# Security headers — все страницы
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'self' https://webvisor.com https://*.webvisor.com https://metrika.yandex.ru https://metrika.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://mc.yandex.ru
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Кэш immutable для сборочных файлов Next.js (хэш в имени)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Шрифты — год кэш (файлы не меняются)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Изображения — месяц кэш
/tea/*
  Cache-Control: public, max-age=2592000
/textures/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000
/logo/*
  Cache-Control: public, max-age=2592000

# Фото по папкам — месяц кэш. Layero понимает только правила по папкам: «/*.webp» ниже он
# пропускает, и до 17.11.2026 фото шли с max-age=0 (качались заново при каждом заходе).
# /gallery/feed.json (лента Instagram, обновляется) сюда специально не попадает — у неё свой путь.
/gallery/2026-11/*
  Cache-Control: public, max-age=2592000
/gallery/2026-09/*
  Cache-Control: public, max-age=2592000
/gallery/feed/*
  Cache-Control: public, max-age=2592000
/gallery/clean/*
  Cache-Control: public, max-age=2592000
/gallery/head-spa/*
  Cache-Control: public, max-age=2592000
/feed-img/*
  Cache-Control: public, max-age=2592000
/certificates/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=2592000

# Общие правила по расширению
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

# Фиды и служебные файлы — короткий кэш
/offers.xml
  Cache-Control: public, max-age=3600
/offers.yml
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=86400
/llms.txt
  Cache-Control: public, max-age=86400
